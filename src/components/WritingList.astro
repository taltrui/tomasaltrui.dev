---
import MainLayout from "@/layouts/main.astro";
import { formatDate, type Lang, localize } from "@/lib/i18n";
import { getPosts } from "@/lib/writing";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
---

<MainLayout lang={lang} title={lang === "en" ? "tomás altrui | writing" : "tomás altrui | escritura"}>
	<div class="space-y-6">
		{
			posts.map((post) => (
				<article class="border-l-2 border-border pl-4 hover:border-foreground transition-colors">
					<a href={localize(lang, `/writing/${post.slug}`)} class="block group">
						<time class="text-sm text-muted-foreground" datetime={post.data.date}>
							{formatDate(post.data.date, lang)}
						</time>
						<h2 class="text-2xl font-bold mt-1 group-hover:underline underline-offset-4">{post.data.title}</h2>
					</a>
				</article>
			))
		}
	</div>
</MainLayout>
