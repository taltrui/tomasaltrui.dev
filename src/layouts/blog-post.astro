---
import { render } from "astro:content";
import MainLayout from "@/layouts/main.astro";
import { formatDate, type Lang, localize } from "@/lib/i18n";
import { getPostPaths, type Post } from "@/lib/writing";

interface Props {
	lang: Lang;
	post: Post;
}

const { lang, post } = Astro.props;
const { title, date, description } = post.data;
const { Content } = await render(post);
const paths = await getPostPaths(post);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	datePublished: date,
	inLanguage: lang,
	author: { "@type": "Person", name: "Tomás Altrui", url: Astro.site?.href },
};
---

<MainLayout lang={lang} title={title} description={description} type="article" paths={paths}>
	<Fragment slot="head">
		<meta property="article:published_time" content={date} />
		<meta property="article:author" content="Tomás Altrui" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
	<article class="max-w-none">
		<header class="mb-8">
			<a href={localize(lang, "/writing")} class="hover:underline underline-offset-4 text-sm mb-4 inline-block">
				{lang === "en" ? "← back to writing" : "← volver a escritura"}
			</a>
			<h1 class="text-4xl font-bold mb-2">{title}</h1>
			<time class="text-muted-foreground text-sm" datetime={date}>{formatDate(date, lang)}</time>
		</header>
		<div class="blog-content">
			<Content />
		</div>
	</article>
</MainLayout>

<style is:global>
	.blog-content h1 {
		font-size: 1.875rem;
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.blog-content h2 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}

	.blog-content h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-top: 1rem;
		margin-bottom: 0.5rem;
	}

	.blog-content p {
		margin-bottom: 1rem;
		line-height: 1.625;
	}

	.blog-content a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.blog-content a:hover {
		text-decoration: none;
	}

	.blog-content ul,
	.blog-content ol {
		margin-bottom: 1rem;
		margin-left: 1.5rem;
	}

	.blog-content li {
		margin-bottom: 0.5rem;
	}

	.blog-content code {
		background-color: var(--color-muted);
		color: inherit;
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.blog-content pre {
		background-color: var(--color-muted);
		padding: 1rem;
		border-radius: 0.5rem;
		margin-bottom: 1rem;
		overflow-x: auto;
	}

	.blog-content pre code {
		background-color: transparent;
		padding: 0;
	}

	.blog-content blockquote {
		border-left: 4px solid var(--color-border);
		padding-left: 1rem;
		font-style: italic;
		margin: 1rem 0;
	}

	.blog-content table {
		width: 100%;
		margin-bottom: 1rem;
		border-collapse: collapse;
	}

	.blog-content th,
	.blog-content td {
		border: 1px solid var(--color-muted);
		padding: 0.5rem 1rem;
	}

	.blog-content th {
		background-color: var(--color-muted);
		font-weight: 700;
	}
</style>
